{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/current-state-analysis.json",
  "title": "Current-State Analysis",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "skill_id": {
      "const": "current-state-analysis"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "capabilities",
          "actors",
          "flows",
          "rules",
          "exceptions",
          "evidence",
          "traceability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capabilities": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "actors": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "flows": {
            "type": "string"
          },
          "rules": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "exceptions": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "evidence": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "traceability": {
            "type": [
              "object",
              "array",
              "string"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
