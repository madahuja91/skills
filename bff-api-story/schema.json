{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/bff-api-story.json",
  "title": "BFF/API Story",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "skill_id": {
      "const": "bff-api-story"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "title",
          "technical_objective",
          "technical_scope",
          "target_components",
          "component_responsibilities",
          "interfaces_and_contracts",
          "data_flow",
          "dependencies",
          "implementation_changes",
          "validation_and_error_handling",
          "security",
          "observability",
          "transaction_and_consistency",
          "migration_considerations",
          "backward_compatibility",
          "testing_strategy",
          "sac",
          "traceability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "technical_objective": {
            "type": "string"
          },
          "technical_scope": {
            "type": "string"
          },
          "target_components": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "component_responsibilities": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "interfaces_and_contracts": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "data_flow": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "implementation_changes": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "validation_and_error_handling": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "security": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "observability": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "transaction_and_consistency": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "migration_considerations": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "backward_compatibility": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "testing_strategy": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "sac": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "traceability": {
            "type": [
              "object",
              "array",
              "string"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
