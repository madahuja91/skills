{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa-tech-architecture.json",
  "title": "CSATechArchitectureArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "scope",
    "overall_confidence_score",
    "architecture_layers",
    "technical_debt_assessment",
    "validation_results"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "agent_id": { "const": "tech_architecture" },
    "agent_version": { "type": "string" },
    "timestamp": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "scope": { "type": "object" },
    "overall_confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "analysis_scope": {
      "type": "string",
      "enum": ["static", "runtime", "combined"]
    },
    "processing_time_ms": { "type": "integer" },
    "architecture_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer_id", "layer_name", "components"],
        "properties": {
          "layer_id": { "type": "string" },
          "layer_name": {
            "type": "string",
            "enum": ["presentation", "business", "data", "integration", "infrastructure"]
          },
          "layer_description": { "type": "string" },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["component_id", "component_name", "component_type", "confidence_score"],
              "properties": {
                "component_id": { "type": "string", "pattern": "^CMP-" },
                "component_name": { "type": "string" },
                "component_type": {
                  "type": "string",
                  "enum": ["service", "controller", "repository", "adapter", "utility", "batch", "screen", "unknown"]
                },
                "technology_stack": { "type": "array", "items": { "type": "string" } },
                "responsibilities": { "type": "array", "items": { "type": "string" } },
                "interfaces": { "type": "array" },
                "dependencies": { "type": "array" },
                "business_capabilities": { "type": "array", "items": { "type": "string" } },
                "performance_characteristics": { "type": "object" },
                "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "evidence": { "type": "array" }
              },
              "additionalProperties": false
            }
          },
          "runtime_deviations": { "type": "array" },
          "dead_code": { "type": "array" },
          "hidden_flows": { "type": "array" },
          "technical_debt_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "layer_health_score": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      }
    },
    "performance_analysis": { "type": "object" },
    "technical_debt_assessment": {
      "type": "object",
      "required": ["overall_debt_score", "debt_categories"],
      "properties": {
        "overall_debt_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "debt_categories": { "type": "object" },
        "remediation_priorities": { "type": "array" }
      }
    },
    "infrastructure_mapping": { "type": "object" },
    "c4_views": {
      "type": "object",
      "properties": {
        "context": { "type": "object" },
        "containers": { "type": "array" },
        "components_critical": { "type": "array" }
      }
    },
    "validation_results": { "type": "object" },
    "recommendations": { "type": "array" }
  },
  "additionalProperties": false
}
