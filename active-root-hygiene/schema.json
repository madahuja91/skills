{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/active-root-hygiene.json",
  "title": "ActiveRootHygieneCheck",
  "type": "object",
  "required": [
    "schema_version",
    "active_root",
    "nested_src_src_found",
    "duplicate_roots_found",
    "removed_paths",
    "result"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "active_root": { "type": "string", "minLength": 1 },
    "nested_src_src_found": { "type": "boolean" },
    "duplicate_roots_found": { "type": "boolean" },
    "removed_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remaining_violations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "pass_with_warnings"]
    }
  },
  "additionalProperties": false
}
