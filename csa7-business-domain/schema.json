{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa7-business-domain.json",
  "title": "CSABusinessDomainArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "scope",
    "overall_confidence_score",
    "business_domains",
    "business_capabilities",
    "workflows",
    "operation_dispatch_rules",
    "validation_results",
    "pack_substance"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "agent_id": {
      "const": "business_domain"
    },
    "agent_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": {
      "const": "3.0.0-knowledge-first"
    },
    "scope": {
      "type": "object"
    },
    "overall_confidence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "processing_time_ms": {
      "type": "integer"
    },
    "business_domains": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "domain_id",
          "domain_name",
          "canonical_name",
          "entities",
          "business_rules",
          "confidence_score"
        ],
        "properties": {
          "domain_id": {
            "type": "string",
            "pattern": "^DOM-"
          },
          "domain_name": {
            "type": "string"
          },
          "canonical_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "normalization_applied": {
            "type": "boolean"
          },
          "normalization_details": {
            "type": "object"
          },
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "entity_id",
                "entity_name",
                "entity_type",
                "confidence_score",
                "extraction_source"
              ],
              "properties": {
                "entity_id": {
                  "type": "string",
                  "pattern": "^ENT-"
                },
                "entity_name": {
                  "type": "string"
                },
                "canonical_name": {
                  "type": "string"
                },
                "entity_type": {
                  "type": "string",
                  "enum": [
                    "aggregate",
                    "entity",
                    "value_object",
                    "service"
                  ]
                },
                "attributes": {
                  "type": "array"
                },
                "relationships": {
                  "type": "array"
                },
                "confidence_score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "extraction_source": {
                  "type": "string",
                  "enum": [
                    "code",
                    "documentation",
                    "configuration",
                    "inferred"
                  ]
                },
                "evidence": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          },
          "business_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule_id",
                "rule_name",
                "rule_category",
                "rule_description",
                "confidence_score",
                "extraction_source"
              ],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^BR-"
                },
                "rule_name": {
                  "type": "string"
                },
                "rule_category": {
                  "type": "string",
                  "enum": [
                    "validation",
                    "calculation",
                    "workflow",
                    "authorization",
                    "integration"
                  ]
                },
                "rule_description": {
                  "type": "string"
                },
                "pseudo_code": {
                  "type": "string"
                },
                "implementation_location": {
                  "type": "object",
                  "properties": {
                    "file_path": {
                      "type": "string"
                    },
                    "method_name": {
                      "type": "string"
                    },
                    "line_numbers": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "validation_type": {
                  "type": "string",
                  "enum": [
                    "client_side",
                    "server_side",
                    "database",
                    "cross_system"
                  ]
                },
                "business_impact": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "dependencies": {
                  "type": "array"
                },
                "configuration_variations": {
                  "type": "array"
                },
                "confidence_score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "extraction_source": {
                  "type": "string",
                  "enum": [
                    "code",
                    "documentation",
                    "configuration",
                    "inferred"
                  ]
                },
                "uncertainty_reason": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          },
          "cross_domain_dependencies": {
            "type": "array"
          },
          "confidence_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    "business_capabilities": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "capability_name",
          "supporting_domains",
          "confidence_score"
        ],
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "capability_name": {
            "type": "string"
          },
          "capability_description": {
            "type": "string"
          },
          "supporting_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "business_value": {
            "type": "string"
          },
          "complexity_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "implementation_components": {
            "type": "array"
          },
          "business_rules_applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_dependencies": {
            "type": "array"
          },
          "integration_dependencies": {
            "type": "array"
          },
          "confidence_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "workflow_id",
          "workflow_name",
          "steps",
          "evidence"
        ],
        "properties": {
          "workflow_id": {
            "type": "string",
            "pattern": "^WF-"
          },
          "workflow_name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "operation_dispatch_rules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "dispatch_key",
          "condition",
          "handler",
          "evidence"
        ],
        "properties": {
          "dispatch_key": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "handler": {
            "type": "string"
          },
          "fallback": {
            "type": "string"
          },
          "auth_context": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "feature_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flag_name",
          "behavior_gated",
          "default_state",
          "evidence"
        ],
        "properties": {
          "flag_name": {
            "type": "string"
          },
          "behavior_gated": {
            "type": "string"
          },
          "default_state": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "provider_selection_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_name",
          "selector",
          "selected_provider_or_path",
          "evidence"
        ],
        "properties": {
          "rule_name": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "selected_provider_or_path": {
            "type": "string"
          },
          "default_fallback": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "validation_results": {
      "type": "object",
      "required": [
        "domain_completeness",
        "confidence_distribution"
      ],
      "properties": {
        "domain_completeness": {
          "type": "object"
        },
        "normalization_effectiveness": {
          "type": "object"
        },
        "confidence_distribution": {
          "type": "object"
        },
        "missing_business_logic": {
          "type": "array"
        }
      }
    },
    "recommendations": {
      "type": "array"
    },
    "pack_substance": {
      "type": "object",
      "required": [
        "overview",
        "bounded_contexts",
        "capability_taxonomy",
        "business_rules",
        "acceptance_criteria",
        "domain_model",
        "ubiquitous_dictionary",
        "capability_flows",
        "operation_dispatch_rules",
        "feature_flag_catalogue",
        "provider_selection_rules",
        "gap_analysis_bullets",
        "evidence_appendix"
      ],
      "properties": {
        "overview": {
          "type": "object",
          "required": [
            "what",
            "why",
            "how_summary"
          ],
          "properties": {
            "what": {
              "type": "string",
              "minLength": 60
            },
            "why": {
              "type": "string",
              "minLength": 40
            },
            "how_summary": {
              "type": "string",
              "minLength": 60,
              "description": "High-level business flow: Request → Validation → Rules → Persist → Integration → Notification."
            }
          },
          "additionalProperties": false
        },
        "bounded_contexts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "context_name",
              "domain_type",
              "description",
              "what",
              "why",
              "aggregates"
            ],
            "properties": {
              "context_name": {
                "type": "string",
                "minLength": 2
              },
              "domain_type": {
                "type": "string",
                "enum": [
                  "Core",
                  "Supporting",
                  "Generic"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 40
              },
              "what": {
                "type": "string",
                "minLength": 30
              },
              "why": {
                "type": "string",
                "minLength": 20
              },
              "aggregates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "aggregate_root",
                    "entities"
                  ],
                  "properties": {
                    "aggregate_root": {
                      "type": "string",
                      "minLength": 2
                    },
                    "entities": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "value_objects": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "capability_taxonomy": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "capability_id",
              "l1_capability",
              "l2_capability",
              "what",
              "why",
              "how",
              "criticality",
              "realizing_components"
            ],
            "properties": {
              "capability_id": {
                "type": "string",
                "pattern": "^CAP-"
              },
              "l1_capability": {
                "type": "string",
                "minLength": 2
              },
              "l2_capability": {
                "type": "string",
                "minLength": 2
              },
              "what": {
                "type": "string",
                "minLength": 40
              },
              "why": {
                "type": "string",
                "minLength": 25
              },
              "how": {
                "type": "string",
                "minLength": 40,
                "description": "Architecture behaviour in business steps, not class lists."
              },
              "criticality": {
                "type": "string",
                "enum": [
                  "Mission-Critical",
                  "Business-Operational",
                  "Administrative"
                ]
              },
              "realizing_components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "business_rules": {
          "type": "array",
          "minItems": 8,
          "description": "Prose business rules (e.g. Customer cannot be deleted when active orders exist) — not file:line citations.",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "rule",
              "business_intent",
              "capability_id"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^BR-"
              },
              "rule": {
                "type": "string",
                "minLength": 20
              },
              "business_intent": {
                "type": "string",
                "minLength": 15
              },
              "capability_id": {
                "type": "string",
                "pattern": "^CAP-"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 8,
          "description": "Per-capability acceptance criteria for migration teams.",
          "items": {
            "type": "object",
            "required": [
              "capability_id",
              "criteria"
            ],
            "properties": {
              "capability_id": {
                "type": "string",
                "pattern": "^CAP-"
              },
              "criteria": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 10
                }
              }
            },
            "additionalProperties": false
          }
        },
        "domain_model": {
          "type": "array",
          "minItems": 3,
          "description": "Full DDD shapes with explanation — Aggregate Root, Entities, VOs, Domain Services, Repositories, Domain Events.",
          "items": {
            "type": "object",
            "required": [
              "bounded_context",
              "aggregate_name",
              "aggregate_root",
              "entities",
              "value_objects",
              "repository",
              "explanation"
            ],
            "properties": {
              "bounded_context": {
                "type": "string",
                "minLength": 2
              },
              "aggregate_name": {
                "type": "string",
                "minLength": 2
              },
              "aggregate_root": {
                "type": "string",
                "minLength": 2
              },
              "entities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "value_objects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "domain_services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "repository": {
                "type": "string",
                "minLength": 2
              },
              "domain_events": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "explanation": {
                "type": "string",
                "minLength": 40
              }
            },
            "additionalProperties": false
          }
        },
        "ubiquitous_dictionary": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "term",
              "definition"
            ],
            "properties": {
              "term": {
                "type": "string",
                "minLength": 2
              },
              "definition": {
                "type": "string",
                "minLength": 15
              },
              "legacy_mapping": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "capability_flows": {
          "type": "array",
          "minItems": 3,
          "description": "Business workflows (Receive → Validate → Rules → Persist → Notify), not DAO chains.",
          "items": {
            "type": "object",
            "required": [
              "flow_id",
              "flow_name",
              "steps",
              "capabilities"
            ],
            "properties": {
              "flow_id": {
                "type": "string",
                "pattern": "^WF-"
              },
              "flow_name": {
                "type": "string",
                "minLength": 3
              },
              "steps": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "operation_dispatch_rules": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "dispatch_key",
              "condition",
              "handler"
            ],
            "properties": {
              "dispatch_key": {
                "type": "string",
                "minLength": 2
              },
              "condition": {
                "type": "string",
                "minLength": 3
              },
              "handler": {
                "type": "string",
                "minLength": 3
              },
              "fallback": {
                "type": "string"
              },
              "auth_context": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "feature_flag_catalogue": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "flag_name",
              "behavior_gated",
              "default_state"
            ],
            "properties": {
              "flag_name": {
                "type": "string",
                "minLength": 2
              },
              "behavior_gated": {
                "type": "string",
                "minLength": 5
              },
              "default_state": {
                "type": "string",
                "minLength": 2
              },
              "source": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "provider_selection_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rule_name",
              "selector",
              "selected_provider_or_path"
            ],
            "properties": {
              "rule_name": {
                "type": "string",
                "minLength": 3
              },
              "selector": {
                "type": "string",
                "minLength": 2
              },
              "selected_provider_or_path": {
                "type": "string",
                "minLength": 2
              },
              "default_fallback": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "gap_analysis_bullets": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "evidence_appendix": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "claim_ref",
              "path_or_artifact",
              "note"
            ],
            "properties": {
              "claim_ref": {
                "type": "string",
                "minLength": 3
              },
              "path_or_artifact": {
                "type": "string",
                "minLength": 3
              },
              "note": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Knowledge-first pack substance. Narrative sections required; evidence_appendix last. Validates against https://csa.local/schemas/Business_Architecture.schema.json."
    }
  },
  "additionalProperties": false
}
