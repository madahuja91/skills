{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/gate-discover.json",
  "title": "GateDiscoverEvaluation",
  "description": "Completeness Validator evaluation contract for discovery.json",
  "type": "object",
  "required": ["gate_id", "target_artifact", "rubric_checks", "result"],
  "properties": {
    "gate_id": { "const": "gate-discover" },
    "target_artifact": { "type": "string", "pattern": ".*discovery\\.json$" },
    "target_schema": { "const": "skills/agents/csa-discover/schema.json" },
    "rubric_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "description", "passed", "blocking"],
        "properties": {
          "check_id": {
            "type": "string",
            "enum": [
              "schema_conformance",
              "classification_coverage",
              "primary_language",
              "framework_or_unknown_with_evidence",
              "stack_evidence_coverage",
              "module_map_present",
              "no_invented_modern_stack"
            ]
          },
          "description": { "type": "string" },
          "passed": { "type": "boolean" },
          "blocking": { "type": "boolean" },
          "observed": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "classification_coverage_pct": { "type": "number", "const": 90 },
        "stack_evidence_non_inferred_pct": { "type": "number", "const": 70 }
      }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "pass_with_warnings"]
    }
  },
  "additionalProperties": false
}
