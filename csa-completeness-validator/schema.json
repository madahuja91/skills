{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/completeness-validator-invocation.json",
  "title": "CompletenessValidatorInvocation",
  "type": "object",
  "required": ["mode", "gate_id", "attempt", "max_reruns"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["lane", "final"]
    },
    "artifact_path": {
      "type": "string",
      "description": "Required for lane mode — single specialist artifact path"
    },
    "artifact_paths": {
      "type": "array",
      "description": "Required for final mode — all five specialist artifacts",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "gate_id": {
      "type": "string",
      "enum": [
        "gate-discover",
        "gate-business-domain",
        "gate-tech-architecture",
        "gate-data-lineage",
        "gate-integration",
        "gate-csa-document"
      ]
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "max_reruns": { "type": "integer", "const": 2 },
    "prior_context": { "type": "string" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "lane" } } },
      "then": { "required": ["artifact_path"] }
    },
    {
      "if": { "properties": { "mode": { "const": "final" } } },
      "then": {
        "required": ["artifact_paths"],
        "properties": {
          "gate_id": { "const": "gate-csa-document" }
        }
      }
    }
  ]
}
