{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/story-decomposition.json",
  "title": "Technical Story Decomposition",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "skill_id": {
      "const": "story-decomposition"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "selected_areas",
          "skipped_areas",
          "rationale_per_area",
          "dependency_graph",
          "contract_boundaries",
          "traceability"
        ],
        "properties": {
          "selected_areas": {
            "type": [
              "array",
              "string",
              "object"
            ]
          },
          "skipped_areas": {
            "type": [
              "array",
              "string",
              "object"
            ]
          },
          "rationale_per_area": {
            "type": "string"
          },
          "dependency_graph": {
            "type": "string"
          },
          "contract_boundaries": {
            "type": "string"
          },
          "traceability": {
            "type": [
              "object",
              "array",
              "string"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
