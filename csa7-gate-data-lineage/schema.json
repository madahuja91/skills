{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa7-gate-data-lineage.json",
  "title": "GateDataLineageEvaluation",
  "type": "object",
  "required": ["gate_id", "target_artifact", "rubric_checks", "result"],
  "properties": {
    "gate_id": { "const": "gate-data-lineage" },
    "target_artifact": { "type": "string", "pattern": ".*lineage\\.json$" },
    "target_schema": { "const": "skills/agents/csa7-data-lineage/schema.json" },
    "rubric_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "description", "passed", "blocking"],
        "properties": {
          "check_id": {
            "type": "string",
            "enum": [
              "schema_conformance",
              "data_sources_present",
              "primary_entity_path_coverage",
              "lineage_or_table_level_justified",
              "lineage_evidence_coverage",
              "lineage_scope_matches_depth"
            ]
          },
          "description": { "type": "string" },
          "passed": { "type": "boolean" },
          "blocking": { "type": "boolean" },
          "observed": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "pass_with_warnings"]
    }
  },
  "additionalProperties": false
}
