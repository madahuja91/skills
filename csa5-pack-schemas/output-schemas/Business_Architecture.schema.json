{

  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://csa.local/schemas/Business_Architecture.schema.json",

  "title": "CSA_Business_Architecture",

  "type": "object",

  "required": [

    "bounded_contexts",

    "capability_taxonomy",

    "ubiquitous_dictionary",

    "capability_flows",

    "operation_dispatch_rules",

    "feature_flag_catalogue",

    "provider_selection_rules",

    "gap_analysis_bullets"

  ],

  "properties": {

    "bounded_contexts": {

      "type": "array",

      "minItems": 3,

      "items": {

        "type": "object",

        "required": ["context_name", "domain_type", "description", "aggregates", "evidence"],

        "properties": {

          "context_name": { "type": "string", "minLength": 2 },

          "domain_type": { "type": "string", "enum": ["Core", "Supporting", "Generic"] },

          "description": { "type": "string", "minLength": 40 },

          "aggregates": {

            "type": "array",

            "minItems": 1,

            "items": {

              "type": "object",

              "required": ["aggregate_root", "entities"],

              "properties": {

                "aggregate_root": { "type": "string", "minLength": 2 },

                "entities": { "type": "array", "minItems": 1, "items": { "type": "string" } },

                "value_objects": { "type": "array", "items": { "type": "string" } }

              },

              "additionalProperties": false

            }

          },

          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }

        },

        "additionalProperties": false

      }

    },

    "capability_taxonomy": {

      "type": "array",

      "minItems": 8,

      "items": {

        "type": "object",

        "required": [

          "capability_id",

          "l1_capability",

          "l2_capability",

          "criticality",

          "realizing_components",

          "evidence"

        ],

        "properties": {

          "capability_id": { "type": "string", "pattern": "^CAP-" },

          "l1_capability": { "type": "string", "minLength": 2 },

          "l2_capability": { "type": "string", "minLength": 2 },

          "criticality": {

            "type": "string",

            "enum": ["Mission-Critical", "Business-Operational", "Administrative"]

          },

          "realizing_components": {

            "type": "array",

            "minItems": 1,

            "items": { "type": "string", "minLength": 2 }

          },

          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }

        },

        "additionalProperties": false

      }

    },

    "ubiquitous_dictionary": {

      "type": "array",

      "minItems": 8,

      "items": {

        "type": "object",

        "required": ["term", "definition"],

        "properties": {

          "term": { "type": "string", "minLength": 2 },

          "definition": { "type": "string", "minLength": 15 },

          "legacy_mapping": { "type": "string" }

        },

        "additionalProperties": false

      }

    },

    "capability_flows": {

      "type": "array",

      "minItems": 3,

      "description": "End-to-end capability flows (reference catalog/E2E flows). Not a duplicate of Data lineage.",

      "items": {

        "type": "object",

        "required": ["flow_id", "flow_name", "steps", "capabilities", "evidence"],

        "properties": {

          "flow_id": { "type": "string", "pattern": "^WF-" },

          "flow_name": { "type": "string", "minLength": 3 },

          "steps": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 3 } },

          "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },

          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }

        },

        "additionalProperties": false

      }

    },

    "operation_dispatch_rules": {

      "type": "array",

      "minItems": 5,

      "description": "Routing/dispatch / operation-context table from business logic — not HTTP integration catalog.",

      "items": {

        "type": "object",

        "required": ["dispatch_key", "condition", "handler", "evidence"],

        "properties": {

          "dispatch_key": { "type": "string", "minLength": 2 },

          "condition": { "type": "string", "minLength": 3 },

          "handler": { "type": "string", "minLength": 3 },

          "fallback": { "type": "string" },

          "auth_context": { "type": "string" },

          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }

        },

        "additionalProperties": false

      }

    },

    "feature_flag_catalogue": {

      "type": "array",

      "minItems": 1,

      "description": "Feature flags/toggles. Empty array only when none evidenced; then document gap in gap_analysis_bullets.",

      "items": {

        "type": "object",

        "required": ["flag_name", "behavior_gated", "default_state", "evidence"],

        "properties": {

          "flag_name": { "type": "string", "minLength": 2 },

          "behavior_gated": { "type": "string", "minLength": 5 },

          "default_state": { "type": "string", "minLength": 2 },

          "source": { "type": "string" },

          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }

        },

        "additionalProperties": false

      }

    },

    "provider_selection_rules": {

      "type": "array",

      "minItems": 1,

      "description": "Vendor/provider/billing-type business selection rules — not the full integration inventory.",

      "items": {

        "type": "object",

        "required": ["rule_name", "selector", "selected_provider_or_path", "evidence"],

        "properties": {

          "rule_name": { "type": "string", "minLength": 3 },

          "selector": { "type": "string", "minLength": 2 },

          "selected_provider_or_path": { "type": "string", "minLength": 2 },

          "default_fallback": { "type": "string" },

          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }

        },

        "additionalProperties": false

      }

    },

    "gap_analysis_bullets": {

      "type": "array",

      "minItems": 3,

      "items": { "type": "string", "minLength": 20 }

    }

  },

  "additionalProperties": false

}

