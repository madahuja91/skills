{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/sk-ac.json",
  "title": "AcceptanceCriteria",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "mode",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skill_id": {
      "const": "SK-AC"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Expected under ACTIVE_ROOT: artifacts/cs/acceptance_criteria.json, artifacts/ts/acceptance_criteria.json"
    },
    "mode": {
      "type": "string",
      "enum": [
        "cs",
        "ts"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "story_id",
          "criteria"
        ],
        "properties": {
          "story_id": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "given",
                "when",
                "then"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "given": {
                  "type": "string"
                },
                "when": {
                  "type": "string"
                },
                "then": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "md_updated": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
