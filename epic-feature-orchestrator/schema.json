{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/epic-feature-orchestrator.json",
  "title": "Epic Feature Orchestration",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "skill_id": {
      "const": "epic-feature-orchestrator"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
