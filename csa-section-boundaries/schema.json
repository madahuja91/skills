{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa-section-boundaries.json",
  "title": "CsaSectionBoundaries",
  "type": "object",
  "required": [
    "contract_version",
    "canonical_owners",
    "max_markdown_pair_jaccard",
    "forbidden_primary_deliverables",
    "blocking_check_id"
  ],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0.0" },
    "canonical_owners": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "max_markdown_pair_jaccard": { "type": "number", "const": 0.32 },
    "forbidden_primary_deliverables": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "blocking_check_id": {
      "type": "string",
      "const": "section_anti_redundancy"
    },
    "required_pack_markdown": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 8
    }
  },
  "additionalProperties": false
}
