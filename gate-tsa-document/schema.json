{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsa.local/schemas/gate-tsa-document.json",
  "title": "gate-tsa-document",
  "type": "object",
  "required": ["gate_id", "result", "findings"],
  "properties": {
    "gate_id": {
      "const": "gate-tsa-document"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "pass_with_warnings"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "passed", "blocking", "description"],
        "properties": {
          "check_id": {
            "type": "string",
            "enum": [
              "required_docs_present",
              "schema_conformance",
              "deterministic_rendering",
              "traceability_present",
              "active_root_hygiene"
            ]
          },
          "passed": { "type": "boolean" },
          "blocking": { "type": "boolean" },
          "description": { "type": "string" },
          "observed": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
