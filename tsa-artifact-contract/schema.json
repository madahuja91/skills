{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsa.local/schemas/tsa-artifact-contract.json",
  "title": "TsaArtifactContract",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "overall_confidence_score",
    "csa_refs",
    "adr_refs"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "overall_confidence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "csa_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adr_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_reason": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
