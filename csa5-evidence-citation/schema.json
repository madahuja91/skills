{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa5-evidence-citation.json",
  "title": "CSAEvidenceCitation",
  "description": "Single evidence reference attached to a CSA claim",
  "type": "object",
  "required": ["path", "kind"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to scope.codebase_root"
    },
    "lines": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 1,
      "maxItems": 2
    },
    "kind": {
      "type": "string",
      "enum": ["code", "config", "ddl", "descriptor", "doc", "log", "inferred"]
    },
    "note": { "type": "string" }
  },
  "additionalProperties": false
}
