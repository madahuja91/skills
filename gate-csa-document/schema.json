{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/gate-csa-document.json",
  "title": "GateCsaDocumentEvaluation",
  "type": "object",
  "required": ["gate_id", "target_root", "rubric_checks", "result"],
  "properties": {
    "gate_id": { "const": "gate-csa-document" },
    "target_root": { "type": "string", "pattern": ".*csa_pack.*" },
    "target_schema": { "const": "skills/agents/csa-document-assembler/schema.json" },
    "required_markdown_sections": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "Executive_Summary.md",
        "Business_Architecture.md",
        "Application_Architecture.md",
        "Data_and_Integration.md",
        "Risks_Gaps_and_Traceability.md",
        "README.md"
      ]
    },
    "required_section_machine_json": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "machine/sections/Executive_Summary.json",
        "machine/sections/Business_Architecture.json",
        "machine/sections/Application_Architecture.json",
        "machine/sections/Data_and_Integration.json",
        "machine/sections/Risks_Gaps_and_Traceability.json"
      ]
    },
    "required_html_pages": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "arc42-c4/index.html",
        "arc42-c4/context.html",
        "arc42-c4/containers.html",
        "arc42-c4/components.html"
      ]
    },
    "forbidden_paths": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "00_executive_summary.md",
        "04_domain_model_ddd.md",
        "05_business_capabilities.md",
        "06_data_architecture_lineage.md",
        "07_integration_landscape.md",
        "08_runtime_ops_tech_debt.md",
        "09_traceability_matrix.md",
        "10_gaps_risks_assumptions.md",
        "01_system_context_c4.md",
        "02_containers_c4.md",
        "03_components_c4.md"
      ]
    },
    "rubric_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "description", "passed", "blocking"],
        "properties": {
          "check_id": {
            "type": "string",
            "enum": [
              "shared_memory_present",
              "markdown_sections_present",
              "section_machine_json_present",
              "html_c4_index_present",
              "readme_links_html_index",
              "no_numbered_legacy_sections",
              "no_c4_markdown",
              "machine_artifacts_synced",
              "traceability_graph_present",
              "gaps_documented",
              "mermaid_required_diagrams_present",
              "mermaid_html_runtime_present",
              "mermaid_inventory_present",
              "required_files_present",
              "schema_conformance",
              "section_min_rows",
              "specialist_list_depth",
              "section_ownership_violation",
              "index_html_hub_richness",
              "table_prose_duplication",
              "section_anti_redundancy",
              "pack_shape_valid"
            ]
          },
          "description": { "type": "string" },
          "passed": { "type": "boolean" },
          "blocking": { "type": "boolean" },
          "observed": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "pass_with_warnings"]
    }
  },
  "additionalProperties": false
}
