{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/gate-csa-document.json",
  "title": "GateCsaDocumentEvaluation",
  "type": "object",
  "required": ["gate_id", "target_root", "rubric_checks", "result"],
  "properties": {
    "gate_id": { "const": "gate-csa-document" },
    "target_root": { "type": "string", "pattern": ".*csa_pack.*" },
    "rendered_by": {
      "const": "Completeness-Validation-Agent",
      "description": "No Document-Assembler; Completeness renders and gates in FINAL mode."
    },
    "substance_schemas": {
      "type": "array",
      "description": "Contracts the rendered lean pack must satisfy",
      "default": [
        "csa-rich-content/schema.json",
        "csa-section-boundaries/schema.json",
        "arc42-c4-views/schema.json",
        "mermaid-diagrams/schema.json",
        "csa-document-assembler/output-schemas/Executive_Summary.schema.json",
        "csa-document-assembler/output-schemas/Business_Architecture.schema.json",
        "csa-document-assembler/output-schemas/Application_Architecture.schema.json",
        "csa-document-assembler/output-schemas/Data_and_Integration.schema.json",
        "csa-document-assembler/output-schemas/Risks_Gaps_and_Traceability.schema.json"
      ],
      "items": { "type": "string" }
    },
    "required_markdown_sections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string" },
      "default": [
        "Executive_Summary.md",
        "Business_Architecture.md",
        "Application_Architecture.md",
        "Data_and_Integration.md",
        "Risks_Gaps_and_Traceability.md",
        "README.md"
      ]
    },
    "required_html_pages": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "arc42-c4/index.html",
        "arc42-c4/context.html",
        "arc42-c4/containers.html",
        "arc42-c4/components.html"
      ]
    },
    "forbidden_paths": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "00_executive_summary.md",
        "04_domain_model_ddd.md",
        "05_business_capabilities.md",
        "06_data_architecture_lineage.md",
        "07_integration_landscape.md",
        "08_runtime_ops_tech_debt.md",
        "09_traceability_matrix.md",
        "10_gaps_risks_assumptions.md",
        "01_system_context_c4.md",
        "02_containers_c4.md",
        "03_components_c4.md",
        "epic_story_seeds/",
        "deliverables/",
        "csa_pack/machine/"
      ]
    },
    "rubric_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "description", "passed", "blocking"],
        "properties": {
          "check_id": {
            "type": "string",
            "enum": [
              "shared_memory_present",
              "markdown_sections_present",
              "html_c4_index_present",
              "index_html_hub_richness",
              "index_required_anchors_present",
              "readme_links_html_index",
              "no_numbered_legacy_sections",
              "no_c4_markdown",
              "no_epic_story_seeds",
              "no_machine_sections_required",
              "gaps_documented",
              "mermaid_required_diagrams_present",
              "mermaid_html_runtime_present",
              "mermaid_index_min_blocks",
              "markdown_min_line_count",
              "required_files_present",
              "schema_conformance",
              "pack_output_schema_conformance",
              "specialist_list_depth",
              "section_ownership_violation",
              "section_anti_redundancy",
              "pack_shape_valid",
              "no_workflow_meta_in_csa_pack",
              "owner_agent_named_on_fail"
            ]
          },
          "description": { "type": "string" },
          "passed": { "type": "boolean" },
          "blocking": { "type": "boolean" },
          "observed": { "type": "string" },
          "target_agent_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "pass_with_warnings"]
    }
  },
  "additionalProperties": false
}
