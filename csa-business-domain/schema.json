{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa-business-domain.json",
  "title": "CSABusinessDomainArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "scope",
    "overall_confidence_score",
    "business_domains",
    "business_capabilities",
    "validation_results"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "agent_id": { "const": "business_domain" },
    "agent_version": { "type": "string" },
    "timestamp": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "scope": { "type": "object" },
    "overall_confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "processing_time_ms": { "type": "integer" },
    "business_domains": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["domain_id", "domain_name", "canonical_name", "entities", "business_rules", "confidence_score"],
        "properties": {
          "domain_id": { "type": "string", "pattern": "^DOM-" },
          "domain_name": { "type": "string" },
          "canonical_name": { "type": "string" },
          "description": { "type": "string" },
          "normalization_applied": { "type": "boolean" },
          "normalization_details": { "type": "object" },
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["entity_id", "entity_name", "entity_type", "confidence_score", "extraction_source"],
              "properties": {
                "entity_id": { "type": "string", "pattern": "^ENT-" },
                "entity_name": { "type": "string" },
                "canonical_name": { "type": "string" },
                "entity_type": {
                  "type": "string",
                  "enum": ["aggregate", "entity", "value_object", "service"]
                },
                "attributes": { "type": "array" },
                "relationships": { "type": "array" },
                "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "extraction_source": {
                  "type": "string",
                  "enum": ["code", "documentation", "configuration", "inferred"]
                },
                "evidence": { "type": "array" }
              },
              "additionalProperties": false
            }
          },
          "business_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule_id",
                "rule_name",
                "rule_category",
                "rule_description",
                "confidence_score",
                "extraction_source"
              ],
              "properties": {
                "rule_id": { "type": "string", "pattern": "^BR-" },
                "rule_name": { "type": "string" },
                "rule_category": {
                  "type": "string",
                  "enum": ["validation", "calculation", "workflow", "authorization", "integration"]
                },
                "rule_description": { "type": "string" },
                "pseudo_code": { "type": "string" },
                "implementation_location": {
                  "type": "object",
                  "properties": {
                    "file_path": { "type": "string" },
                    "method_name": { "type": "string" },
                    "line_numbers": { "type": "array", "items": { "type": "integer" } }
                  }
                },
                "validation_type": {
                  "type": "string",
                  "enum": ["client_side", "server_side", "database", "cross_system"]
                },
                "business_impact": {
                  "type": "string",
                  "enum": ["critical", "high", "medium", "low"]
                },
                "dependencies": { "type": "array" },
                "configuration_variations": { "type": "array" },
                "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "extraction_source": {
                  "type": "string",
                  "enum": ["code", "documentation", "configuration", "inferred"]
                },
                "uncertainty_reason": { "type": "string" },
                "evidence": { "type": "array" }
              },
              "additionalProperties": false
            }
          },
          "cross_domain_dependencies": { "type": "array" },
          "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      }
    },
    "business_capabilities": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["capability_id", "capability_name", "supporting_domains", "confidence_score"],
        "properties": {
          "capability_id": { "type": "string" },
          "capability_name": { "type": "string" },
          "capability_description": { "type": "string" },
          "supporting_domains": { "type": "array", "items": { "type": "string" } },
          "business_value": { "type": "string" },
          "complexity_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "implementation_components": { "type": "array" },
          "business_rules_applied": { "type": "array", "items": { "type": "string" } },
          "data_dependencies": { "type": "array" },
          "integration_dependencies": { "type": "array" },
          "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      }
    },
    "validation_results": {
      "type": "object",
      "required": ["domain_completeness", "confidence_distribution"],
      "properties": {
        "domain_completeness": { "type": "object" },
        "normalization_effectiveness": { "type": "object" },
        "confidence_distribution": { "type": "object" },
        "missing_business_logic": { "type": "array" }
      }
    },
    "recommendations": { "type": "array" }
  },
  "additionalProperties": false
}
