{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsa.local/schemas/tsa-specification.json",
  "title": "TSA_Specification_Schema",
  "type": "object",
  "required": ["target_architecture_pattern", "target_services", "target_integration_patterns"],
  "properties": {
    "target_architecture_pattern": {
      "type": "string",
      "enum": ["Microservices", "Event-Driven Microservices", "Modular Monolith", "Serverless"]
    },
    "target_services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service_id",
          "service_name",
          "bounded_context",
          "tech_stack",
          "replaced_legacy_components",
          "data_ownership"
        ],
        "properties": {
          "service_id": { "type": "string" },
          "service_name": { "type": "string" },
          "bounded_context": { "type": "string" },
          "tech_stack": { "type": "string" },
          "replaced_legacy_components": { "type": "array", "items": { "type": "string" } },
          "data_ownership": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "target_integration_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_type", "source_service", "target_service", "protocol"],
        "properties": {
          "pattern_type": {
            "type": "string",
            "enum": ["REST API Gateway", "Kafka Event Bus", "gRPC Internal", "CDC / Debezium"]
          },
          "source_service": { "type": "string" },
          "target_service": { "type": "string" },
          "protocol": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
