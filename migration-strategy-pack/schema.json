{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsa.local/schemas/migration-strategy-pack.json",
  "title": "MigrationStrategyPack",
  "type": "object",
  "required": [
    "format",
    "path",
    "required_mermaid_diagram_ids"
  ],
  "properties": {
    "format": {
      "const": "markdown"
    },
    "path": {
      "const": "tsa_pack/08_migration_strategy_roadmap.md"
    },
    "required_mermaid_diagram_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "const": "diag-migration-waves"
      }
    }
  },
  "additionalProperties": true
}
