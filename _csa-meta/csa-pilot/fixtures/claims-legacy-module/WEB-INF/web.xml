<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee" version="2.5">
  <display-name>Claims Legacy App</display-name>
  <servlet>
    <servlet-name>ClaimServlet</servlet-name>
    <servlet-class>com.acme.claims.ClaimServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ClaimServlet</servlet-name>
    <url-pattern>/claims/*</url-pattern>
  </servlet-mapping>
  <resource-ref>
    <res-ref-name>jdbc/ClaimsDB</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
  </resource-ref>
</web-app>
