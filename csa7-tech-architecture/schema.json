{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa7-tech-architecture.json",
  "title": "CSATechArchitectureArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "scope",
    "overall_confidence_score",
    "architecture_layers",
    "deployment_topology",
    "security_controls",
    "cross_cutting_concerns",
    "build_and_runtime",
    "technical_debt_assessment",
    "validation_results",
    "c4_views",
    "pack_substance"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "agent_id": {
      "const": "tech_architecture"
    },
    "agent_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": {
      "const": "3.0.0-knowledge-first"
    },
    "scope": {
      "type": "object"
    },
    "overall_confidence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "analysis_scope": {
      "type": "string",
      "enum": [
        "static",
        "runtime",
        "combined"
      ]
    },
    "processing_time_ms": {
      "type": "integer"
    },
    "architecture_layers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "layer_name",
          "components"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "layer_name": {
            "type": "string",
            "enum": [
              "presentation",
              "business",
              "data",
              "integration",
              "infrastructure"
            ]
          },
          "layer_description": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "component_id",
                "component_name",
                "component_type",
                "confidence_score"
              ],
              "properties": {
                "component_id": {
                  "type": "string",
                  "pattern": "^CMP-"
                },
                "component_name": {
                  "type": "string"
                },
                "component_type": {
                  "type": "string",
                  "enum": [
                    "service",
                    "controller",
                    "repository",
                    "adapter",
                    "utility",
                    "batch",
                    "screen",
                    "unknown"
                  ]
                },
                "technology_stack": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "responsibilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "interfaces": {
                  "type": "array"
                },
                "dependencies": {
                  "type": "array"
                },
                "business_capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "performance_characteristics": {
                  "type": "object"
                },
                "confidence_score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "evidence": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          },
          "runtime_deviations": {
            "type": "array"
          },
          "dead_code": {
            "type": "array"
          },
          "hidden_flows": {
            "type": "array"
          },
          "technical_debt_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "layer_health_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    "performance_analysis": {
      "type": "object"
    },
    "technical_debt_assessment": {
      "type": "object",
      "required": [
        "overall_debt_score",
        "debt_categories"
      ],
      "properties": {
        "overall_debt_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "debt_categories": {
          "type": "object"
        },
        "remediation_priorities": {
          "type": "array"
        }
      }
    },
    "infrastructure_mapping": {
      "type": "object"
    },
    "c4_views": {
      "type": "object",
      "description": "Sole machine source for csa_pack/arc42-c4/{context,containers,components}.html. Rendered by Completeness FINAL.",
      "required": [
        "context",
        "containers",
        "components_critical"
      ],
      "properties": {
        "context": {
          "type": "object",
          "required": [
            "system",
            "users",
            "externals"
          ],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "users": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "externals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/c4Evidence"
              }
            }
          },
          "additionalProperties": false
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "container_id",
              "name",
              "technology",
              "description"
            ],
            "properties": {
              "container_id": {
                "type": "string",
                "pattern": "^CTR-"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "technology": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/c4Evidence"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "components_critical": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CMP-"
          }
        }
      },
      "additionalProperties": false
    },
    "deployment_topology": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "node_name",
          "node_type",
          "evidence"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "node_name": {
            "type": "string"
          },
          "node_type": {
            "type": "string",
            "enum": [
              "app_server",
              "web",
              "db",
              "queue",
              "batch",
              "external",
              "unknown"
            ]
          },
          "hosts_or_modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "security_controls": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "control_type",
          "description",
          "evidence"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "control_type": {
            "type": "string",
            "enum": [
              "authentication",
              "authorization",
              "secrets",
              "transport",
              "audit",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "cross_cutting_concerns": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "concern",
          "implementation",
          "evidence"
        ],
        "properties": {
          "concern": {
            "type": "string",
            "enum": [
              "caching",
              "logging",
              "serialization",
              "i18n",
              "config",
              "other"
            ]
          },
          "implementation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "build_and_runtime": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "area",
          "technology",
          "notes",
          "evidence"
        ],
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "build",
              "runtime",
              "framework",
              "serialization",
              "logging",
              "other"
            ]
          },
          "technology": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "validation_results": {
      "type": "object"
    },
    "recommendations": {
      "type": "array"
    },
    "pack_substance": {
      "type": "object",
      "required": [
        "overview",
        "architecture_layers",
        "key_components",
        "runtime_behaviour",
        "security_behaviour",
        "failure_behaviour",
        "build_and_runtime",
        "deployment_topology",
        "security_controls",
        "cross_cutting_concerns",
        "runtime_evidence",
        "decision_log",
        "tech_debt_register",
        "modernization_by_area",
        "ops_gaps",
        "evidence_appendix"
      ],
      "properties": {
        "overview": {
          "type": "object",
          "required": [
            "what",
            "why",
            "how_summary"
          ],
          "properties": {
            "what": {
              "type": "string",
              "minLength": 60
            },
            "why": {
              "type": "string",
              "minLength": 40
            },
            "how_summary": {
              "type": "string",
              "minLength": 60,
              "description": "Request → Validation → Business Rules → Persistence → Integration → Notification."
            }
          },
          "additionalProperties": false
        },
        "architecture_layers": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "layer_name",
              "description",
              "responsibilities",
              "key_technologies"
            ],
            "properties": {
              "layer_name": {
                "type": "string",
                "enum": [
                  "presentation",
                  "business",
                  "data",
                  "integration",
                  "infrastructure"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 30
              },
              "responsibilities": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 15
                }
              },
              "key_technologies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "key_components": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "component_id",
              "component_name",
              "layer",
              "responsibility",
              "what_it_does"
            ],
            "properties": {
              "component_id": {
                "type": "string",
                "pattern": "^CMP-"
              },
              "component_name": {
                "type": "string",
                "minLength": 2
              },
              "layer": {
                "type": "string",
                "minLength": 2
              },
              "responsibility": {
                "type": "string",
                "minLength": 20
              },
              "what_it_does": {
                "type": "string",
                "minLength": 40,
                "description": "Narrative of behaviour — not a file listing."
              },
              "interfaces": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "direction"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "in",
                        "out",
                        "both"
                      ]
                    },
                    "protocol": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "runtime_behaviour": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "scenario",
              "flow_steps",
              "outcome"
            ],
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 10
              },
              "flow_steps": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "outcome": {
                "type": "string",
                "minLength": 15
              }
            },
            "additionalProperties": false
          }
        },
        "security_behaviour": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "concern",
              "behaviour"
            ],
            "properties": {
              "concern": {
                "type": "string",
                "minLength": 5
              },
              "behaviour": {
                "type": "string",
                "minLength": 25
              }
            },
            "additionalProperties": false
          }
        },
        "failure_behaviour": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "failure_mode",
              "observed_handling",
              "business_impact"
            ],
            "properties": {
              "failure_mode": {
                "type": "string",
                "minLength": 10
              },
              "observed_handling": {
                "type": "string",
                "minLength": 20
              },
              "business_impact": {
                "type": "string",
                "minLength": 15
              }
            },
            "additionalProperties": false
          }
        },
        "build_and_runtime": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "area",
              "technology",
              "notes"
            ],
            "properties": {
              "area": {
                "type": "string",
                "enum": [
                  "build",
                  "runtime",
                  "framework",
                  "serialization",
                  "logging",
                  "other"
                ]
              },
              "technology": {
                "type": "string",
                "minLength": 2
              },
              "notes": {
                "type": "string",
                "minLength": 10
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "deployment_topology": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "node_name",
              "node_type"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 2
              },
              "node_name": {
                "type": "string",
                "minLength": 2
              },
              "node_type": {
                "type": "string",
                "enum": [
                  "app_server",
                  "web",
                  "db",
                  "queue",
                  "batch",
                  "external",
                  "unknown"
                ]
              },
              "hosts_or_modules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "security_controls": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "control_id",
              "control_type",
              "description"
            ],
            "properties": {
              "control_id": {
                "type": "string",
                "minLength": 2
              },
              "control_type": {
                "type": "string",
                "enum": [
                  "authentication",
                  "authorization",
                  "secrets",
                  "transport",
                  "audit",
                  "other"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 15
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "cross_cutting_concerns": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "concern",
              "implementation"
            ],
            "properties": {
              "concern": {
                "type": "string",
                "enum": [
                  "caching",
                  "logging",
                  "serialization",
                  "i18n",
                  "config",
                  "other"
                ]
              },
              "implementation": {
                "type": "string",
                "minLength": 10
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "runtime_evidence": {
          "type": "array",
          "minItems": 3,
          "description": "Observed runtime behaviour notes — optional evidence paths; narrative first.",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "observed_behavior",
              "confidence"
            ],
            "properties": {
              "artifact": {
                "type": "string"
              },
              "observed_behavior": {
                "type": "string",
                "minLength": 15
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "UNKNOWN"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "decision_log": {
          "type": "array",
          "minItems": 5,
          "description": "Why SP / MQ / batch / scheduler / cache / sync / async — client always asks.",
          "items": {
            "type": "object",
            "required": [
              "decision_id",
              "topic",
              "current_choice",
              "rationale",
              "tradeoffs"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "pattern": "^DEC-"
              },
              "topic": {
                "type": "string",
                "enum": [
                  "stored_procedure",
                  "mq",
                  "batch",
                  "scheduler",
                  "cache",
                  "sync",
                  "async",
                  "other"
                ]
              },
              "current_choice": {
                "type": "string",
                "minLength": 10
              },
              "rationale": {
                "type": "string",
                "minLength": 30
              },
              "tradeoffs": {
                "type": "string",
                "minLength": 20
              }
            },
            "additionalProperties": false
          }
        },
        "tech_debt_register": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "debt_id",
              "title",
              "category",
              "severity",
              "impact"
            ],
            "properties": {
              "debt_id": {
                "type": "string",
                "pattern": "^DEBT-"
              },
              "title": {
                "type": "string",
                "minLength": 5
              },
              "category": {
                "type": "string",
                "enum": [
                  "Architecture",
                  "Code",
                  "Data",
                  "Integration",
                  "Ops",
                  "Security",
                  "Testing"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "impact": {
                "type": "string",
                "minLength": 15
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "modernization_by_area": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "area",
              "current_state",
              "future_state",
              "migration_complexity",
              "cloud_readiness",
              "microservice_candidate",
              "ddd_readiness",
              "risk",
              "estimated_effort"
            ],
            "properties": {
              "area": {
                "type": "string",
                "minLength": 3
              },
              "current_state": {
                "type": "string",
                "minLength": 20
              },
              "future_state": {
                "type": "string",
                "minLength": 20
              },
              "migration_complexity": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "cloud_readiness": {
                "type": "string",
                "minLength": 10
              },
              "microservice_candidate": {
                "type": "boolean"
              },
              "ddd_readiness": {
                "type": "string",
                "minLength": 10
              },
              "risk": {
                "type": "string",
                "minLength": 15
              },
              "estimated_effort": {
                "type": "string",
                "minLength": 3
              }
            },
            "additionalProperties": false
          }
        },
        "ops_gaps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "evidence_appendix": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "claim_ref",
              "path_or_artifact",
              "note"
            ],
            "properties": {
              "claim_ref": {
                "type": "string",
                "minLength": 3
              },
              "path_or_artifact": {
                "type": "string",
                "minLength": 3
              },
              "note": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Knowledge-first pack substance. Narrative sections required; evidence_appendix last. Validates against https://csa.local/schemas/Application_Architecture.schema.json."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "c4Evidence": {
      "type": "object",
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "code",
            "config",
            "ddl",
            "descriptor",
            "doc",
            "log",
            "inferred"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
