{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/legacy-framework-heuristics-findings.json",
  "title": "LegacyFrameworkHeuristicFindings",
  "description": "Structured findings emitted when applying legacy framework detection heuristics",
  "type": "object",
  "required": ["findings", "scan_summary"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal", "inferred_technology", "confidence_score", "evidence"],
        "properties": {
          "signal": { "type": "string" },
          "inferred_technology": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "language",
              "framework",
              "app_server",
              "orm",
              "messaging",
              "database",
              "batch",
              "unknown"
            ]
          },
          "version": { "type": "string" },
          "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "https://csa.local/schemas/csa7-evidence-citation.json" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "scan_summary": {
      "type": "object",
      "required": ["descriptors_searched", "unresolved_signals"],
      "properties": {
        "descriptors_searched": { "type": "array", "items": { "type": "string" } },
        "unresolved_signals": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
