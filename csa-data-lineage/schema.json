{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa-data-lineage.json",
  "title": "CSADataLineageArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "scope",
    "overall_confidence_score",
    "data_sources",
    "field_lineage",
    "validation_results"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "agent_id": { "const": "data_lineage" },
    "agent_version": { "type": "string" },
    "timestamp": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "scope": { "type": "object" },
    "overall_confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "lineage_scope": {
      "type": "string",
      "enum": ["field_level", "table_level", "system_level"]
    },
    "processing_time_ms": { "type": "integer" },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_name", "source_type", "confidence_score"],
        "properties": {
          "source_id": { "type": "string" },
          "source_name": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["database", "file", "api", "stream", "external"]
          },
          "technology": { "type": "string" },
          "connection_details": { "type": "object" },
          "data_entities": { "type": "array" },
          "access_patterns": { "type": "array" },
          "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "evidence": { "type": "array" }
        },
        "additionalProperties": false
      }
    },
    "field_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lineage_id", "source_field", "target_field", "lineage_confidence_score"],
        "properties": {
          "lineage_id": { "type": "string", "pattern": "^LIN-" },
          "source_field": { "type": "object" },
          "target_field": { "type": "object" },
          "transformation_logic": { "type": "object" },
          "validation_points": { "type": "array" },
          "data_flow_path": { "type": "array" },
          "lineage_confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "extraction_source": {
            "type": "string",
            "enum": ["code", "configuration", "documentation", "inferred"]
          },
          "uncertainty_reason": { "type": "string" },
          "evidence": { "type": "array" }
        },
        "additionalProperties": false
      }
    },
    "data_transformations": { "type": "array" },
    "data_quality_assessment": { "type": "object" },
    "integration_patterns": { "type": "array" },
    "validation_results": {
      "type": "object",
      "required": ["lineage_completeness"],
      "properties": {
        "lineage_completeness": { "type": "object" },
        "transformation_coverage": { "type": "object" },
        "validation_coverage": { "type": "object" }
      }
    },
    "recommendations": { "type": "array" }
  },
  "additionalProperties": false
}
