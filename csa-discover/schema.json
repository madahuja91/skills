{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa-discover.json",
  "title": "CSADiscoverArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "scope",
    "overall_confidence_score",
    "artifact_inventory",
    "technology_stack",
    "dependency_analysis",
    "risk_assessment"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "agent_id": { "const": "discover" },
    "agent_version": { "type": "string" },
    "timestamp": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "scope": { "type": "object" },
    "overall_confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "processing_time_ms": { "type": "integer" },
    "artifact_inventory": {
      "type": "object",
      "required": ["total_artifacts", "classified_artifacts", "unclassified_artifacts", "missing_artifacts"],
      "properties": {
        "total_artifacts": { "type": "integer", "minimum": 0 },
        "classified_artifacts": {
          "type": "object",
          "required": ["code", "data", "config", "runtime", "documentation"],
          "properties": {
            "code": { "type": "array", "items": { "$ref": "#/$defs/classifiedArtifact" } },
            "data": { "type": "array", "items": { "$ref": "#/$defs/classifiedArtifact" } },
            "config": { "type": "array", "items": { "$ref": "#/$defs/classifiedArtifact" } },
            "runtime": { "type": "array", "items": { "$ref": "#/$defs/classifiedArtifact" } },
            "documentation": { "type": "array", "items": { "$ref": "#/$defs/classifiedArtifact" } }
          },
          "additionalProperties": false
        },
        "unclassified_artifacts": { "type": "array", "items": { "type": "string" } },
        "missing_artifacts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "technology_stack": {
      "type": "object",
      "required": ["programming_languages", "frameworks", "databases", "infrastructure"],
      "properties": {
        "programming_languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["language", "version", "file_count", "confidence_score", "evidence"],
            "properties": {
              "language": { "type": "string" },
              "version": { "type": "string" },
              "usage_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
              "file_count": { "type": "integer", "minimum": 0 },
              "confidence_score": { "$ref": "#/$defs/confidenceScore" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 }
            },
            "additionalProperties": false
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["framework_name", "version", "category", "confidence_score", "evidence"],
            "properties": {
              "framework_name": { "type": "string" },
              "version": { "type": "string" },
              "category": {
                "type": "string",
                "enum": ["web", "data", "testing", "build", "enterprise", "ui", "messaging", "unknown"]
              },
              "usage_pattern": { "type": "string" },
              "confidence_score": { "$ref": "#/$defs/confidenceScore" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 }
            },
            "additionalProperties": false
          }
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["database_type", "version", "confidence_score", "evidence"],
            "properties": {
              "database_type": { "type": "string" },
              "version": { "type": "string" },
              "connection_pattern": { "type": "string" },
              "usage_context": { "type": "string" },
              "confidence_score": { "$ref": "#/$defs/confidenceScore" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 }
            },
            "additionalProperties": false
          }
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component_type", "technology", "version", "confidence_score", "evidence"],
            "properties": {
              "component_type": {
                "type": "string",
                "enum": ["server", "container", "cloud_service", "app_server", "batch", "unknown"]
              },
              "technology": { "type": "string" },
              "version": { "type": "string" },
              "configuration": { "type": "object" },
              "confidence_score": { "$ref": "#/$defs/confidenceScore" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "dependency_analysis": {
      "type": "object",
      "required": ["internal_dependencies", "external_dependencies", "dependency_graph"],
      "properties": {
        "internal_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_module", "target_module", "dependency_type", "confidence_score"],
            "properties": {
              "source_module": { "type": "string" },
              "target_module": { "type": "string" },
              "dependency_type": { "type": "string", "enum": ["compile", "runtime", "test"] },
              "relationship_strength": { "type": "string", "enum": ["strong", "medium", "weak"] },
              "confidence_score": { "$ref": "#/$defs/confidenceScore" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
            },
            "additionalProperties": false
          }
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dependency_name", "version", "risk_level", "confidence_score"],
            "properties": {
              "dependency_name": { "type": "string" },
              "version": { "type": "string" },
              "vendor": { "type": "string" },
              "license": { "type": "string" },
              "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
              "security_vulnerabilities": { "type": "array", "items": { "type": "string" } },
              "confidence_score": { "$ref": "#/$defs/confidenceScore" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
            },
            "additionalProperties": false
          }
        },
        "dependency_graph": {
          "type": "object",
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": { "type": "array" },
            "edges": { "type": "array" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "risk_assessment": {
      "type": "object",
      "required": [
        "deprecated_technologies",
        "security_vulnerabilities",
        "compatibility_issues",
        "missing_critical_artifacts",
        "overall_risk_score"
      ],
      "properties": {
        "deprecated_technologies": { "type": "array", "items": { "type": "string" } },
        "security_vulnerabilities": { "type": "array", "items": { "type": "string" } },
        "compatibility_issues": { "type": "array", "items": { "type": "string" } },
        "missing_critical_artifacts": { "type": "array", "items": { "type": "string" } },
        "overall_risk_score": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "module_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id", "module_name", "root_path"],
        "properties": {
          "module_id": { "type": "string" },
          "module_name": { "type": "string" },
          "root_path": { "type": "string" },
          "primary_languages": { "type": "array", "items": { "type": "string" } },
          "estimated_size_files": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "recommendations": { "type": "array" }
  },
  "$defs": {
    "classifiedArtifact": {
      "type": "object",
      "required": ["path", "category"],
      "properties": {
        "path": { "type": "string" },
        "category": { "type": "string" },
        "subtype": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string" },
        "lines": { "type": "array", "items": { "type": "integer" } },
        "kind": {
          "type": "string",
          "enum": ["code", "config", "ddl", "descriptor", "doc", "log", "inferred"]
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "confidenceScore": { "type": "integer", "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": false
}
