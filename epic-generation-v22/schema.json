{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/epic-generation.json",
  "title": "Epic Generation",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "skill_id": {
      "const": "epic-generation"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "business_capability",
          "business_outcome",
          "scope",
          "traceability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "business_capability": {
            "type": "string"
          },
          "business_outcome": {
            "type": "string"
          },
          "scope": {
            "type": [
              "array",
              "string",
              "object"
            ]
          },
          "traceability": {
            "type": [
              "object",
              "array",
              "string"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
