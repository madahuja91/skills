{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/sk-gap.json",
  "title": "GapRegister",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skill_id": {
      "const": "SK-GAP"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Expected under ACTIVE_ROOT: artifacts/ts/gap_register.json"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GAP-"
          },
          "summary": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "cs_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adr_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tsa_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
