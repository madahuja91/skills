{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/swarm-orchestration.json",
  "title": "Swarm Orchestration",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "shared_memory_path",
    "agent_status",
    "retry_count",
    "selected_areas",
    "skipped_areas",
    "correction"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "skill_id": {
      "const": "swarm-orchestration"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "shared_memory_path": {
      "type": "string"
    },
    "agent_status": {
      "type": "object"
    },
    "retry_count": {
      "type": "object"
    },
    "selected_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correction": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
