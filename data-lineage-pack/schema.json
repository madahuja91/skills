{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/data-lineage-pack-markdown.json",
  "title": "DataLineagePackMarkdown",
  "description": "Contract for Markdown data architecture/lineage section",
  "type": "object",
  "required": ["format", "path", "required_headings", "source_artifact"],
  "properties": {
    "format": { "const": "markdown" },
    "path": { "const": "csa_pack/06_data_architecture_lineage.md" },
    "source_artifact": { "const": "artifacts/lineage.json" },
    "source_schema": { "const": "skills/agents/csa-data-lineage/schema.json" },
    "required_headings": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "# Data Architecture and Lineage",
        "## Data Stores",
        "## System Flows",
        "## Critical Entity Lineage",
        "## Transformations and Validations",
        "## Data Quality Risks",
        "## Gaps"
      ]
    },
    "must_state_lineage_scope": { "type": "boolean", "const": true },
    "required_mermaid_diagram_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "const": "diag-lineage-critical" }
    }
  },
  "additionalProperties": false
}
