{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/architecture-analysis.json",
  "title": "Architecture Analysis",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "skill_id": {
      "const": "architecture-analysis"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "boundaries",
          "contracts",
          "constraints",
          "sequencing",
          "coexistence",
          "compatibility",
          "cutover",
          "rollback",
          "traceability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "boundaries": {
            "type": "string"
          },
          "contracts": {
            "type": "string"
          },
          "constraints": {
            "type": "string"
          },
          "sequencing": {
            "type": "string"
          },
          "coexistence": {
            "type": "string"
          },
          "compatibility": {
            "type": "string"
          },
          "cutover": {
            "type": "string"
          },
          "rollback": {
            "type": "string"
          },
          "traceability": {
            "type": [
              "object",
              "array",
              "string"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
