{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/sk-epic.json",
  "title": "Epics",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "epics",
    "dual_surface",
    "nested_layout"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skill_id": {
      "const": "SK-EPIC"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Expected under ACTIVE_ROOT: artifacts/cs/cs_epics.json, artifacts/ts/ts_epics.json, artifacts/{cs|ts}/epics/<EPIC-ID>/epic.md"
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "story_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "story_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "cs",
              "ts"
            ]
          }
        }
      }
    },
    "dual_surface": {
      "type": "boolean",
      "const": true
    },
    "nested_layout": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": true
}
