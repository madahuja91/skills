{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsa.local/schemas/tsa-document-outputs.json",
  "title": "tsa-document-outputs",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "overall_confidence_score",
    "csa_refs",
    "adr_refs",
    "deliverables"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "agent_id": { "const": "document_assembler" },
    "agent_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": { "const": "2.0.0" },
    "overall_confidence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "csa_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adr_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_results": {
      "type": "object"
    },
    "deliverables": {
      "type": "object",
      "required": ["adr_blueprint_md", "migration_strategy_md"],
      "properties": {
        "adr_blueprint_md": { "type": "string", "const": "tsa_pack/ADR_Blueprint.md" },
        "migration_strategy_md": { "type": "string", "const": "tsa_pack/Migration_Strategy.md" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
