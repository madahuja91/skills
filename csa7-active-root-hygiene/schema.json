{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa7-active-root-hygiene.json",
  "title": "ActiveRootHygieneCheck",
  "type": "object",
  "required": [
    "schema_version",
    "active_root",
    "nested_src_src_found",
    "duplicate_roots_found",
    "invented_absolute_paths_found",
    "pack_on_disk_under_active_root",
    "removed_paths",
    "result"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "active_root": { "type": "string", "minLength": 1 },
    "nested_src_src_found": { "type": "boolean" },
    "duplicate_roots_found": { "type": "boolean" },
    "invented_absolute_paths_found": {
      "type": "boolean",
      "description": "True if agents wrote packs/artifacts under invented absolute trees (e.g. /app/temp/csa-run/outputs) outside active_root"
    },
    "pack_on_disk_under_active_root": {
      "type": "boolean",
      "description": "True when csa_pack/ or tsa_pack/ exists on disk under active_root"
    },
    "removed_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remaining_violations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "pass_with_warnings"]
    }
  },
  "additionalProperties": false
}
