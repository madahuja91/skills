{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa7-specialist-worker.json",
  "title": "CsaSpecialistWorker",
  "type": "object",
  "required": [
    "contract_version",
    "write_paths_allowed",
    "write_paths_forbidden",
    "required_skills",
    "execution_rules"
  ],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0.0" },
    "write_paths_allowed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "artifacts/*.json",
          "_internal/swarm/*",
          "active_root.txt"
        ]
      }
    },
    "write_paths_forbidden": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "csa_pack/",
          "deliverables/",
          "csa_pack/machine/",
          "artifacts/quality_gate_reports/"
        ]
      }
    },
    "required_skills": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "csa7-active-root-hygiene",
          "csa7-swarm-shared-memory",
          "csa7-artifact-contract",
          "csa7-evidence-citation",
          "csa-rich-content"
        ]
      }
    },
    "execution_rules": {
      "type": "object",
      "required": [
        "read_shared_memory_first",
        "exact_schema_field_names",
        "no_invention",
        "complete_without_permission"
      ],
      "properties": {
        "read_shared_memory_first": { "type": "boolean", "const": true },
        "exact_schema_field_names": { "type": "boolean", "const": true },
        "no_invention": { "type": "boolean", "const": true },
        "complete_without_permission": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
