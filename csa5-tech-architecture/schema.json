{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa5-tech-architecture.json",
  "title": "CSATechArchitectureArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "agent_id",
    "agent_version",
    "timestamp",
    "schema_version",
    "scope",
    "overall_confidence_score",
    "architecture_layers",
    "deployment_topology",
    "security_controls",
    "cross_cutting_concerns",
    "build_and_runtime",
    "technical_debt_assessment",
    "validation_results",
    "c4_views"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "agent_id": {
      "const": "tech_architecture"
    },
    "agent_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "type": "object"
    },
    "overall_confidence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "analysis_scope": {
      "type": "string",
      "enum": [
        "static",
        "runtime",
        "combined"
      ]
    },
    "processing_time_ms": {
      "type": "integer"
    },
    "architecture_layers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "layer_name",
          "components"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "layer_name": {
            "type": "string",
            "enum": [
              "presentation",
              "business",
              "data",
              "integration",
              "infrastructure"
            ]
          },
          "layer_description": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "component_id",
                "component_name",
                "component_type",
                "confidence_score"
              ],
              "properties": {
                "component_id": {
                  "type": "string",
                  "pattern": "^CMP-"
                },
                "component_name": {
                  "type": "string"
                },
                "component_type": {
                  "type": "string",
                  "enum": [
                    "service",
                    "controller",
                    "repository",
                    "adapter",
                    "utility",
                    "batch",
                    "screen",
                    "unknown"
                  ]
                },
                "technology_stack": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "responsibilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "interfaces": {
                  "type": "array"
                },
                "dependencies": {
                  "type": "array"
                },
                "business_capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "performance_characteristics": {
                  "type": "object"
                },
                "confidence_score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "evidence": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          },
          "runtime_deviations": {
            "type": "array"
          },
          "dead_code": {
            "type": "array"
          },
          "hidden_flows": {
            "type": "array"
          },
          "technical_debt_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "layer_health_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    "performance_analysis": {
      "type": "object"
    },
    "technical_debt_assessment": {
      "type": "object",
      "required": [
        "overall_debt_score",
        "debt_categories"
      ],
      "properties": {
        "overall_debt_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "debt_categories": {
          "type": "object"
        },
        "remediation_priorities": {
          "type": "array"
        }
      }
    },
    "infrastructure_mapping": {
      "type": "object"
    },
    "c4_views": {
      "type": "object",
      "description": "Sole machine source for csa_pack/arc42-c4/{context,containers,components}.html. Rendered by Completeness FINAL.",
      "required": [
        "context",
        "containers",
        "components_critical"
      ],
      "properties": {
        "context": {
          "type": "object",
          "required": [
            "system",
            "users",
            "externals"
          ],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "users": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "externals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/c4Evidence"
              }
            }
          },
          "additionalProperties": false
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "container_id",
              "name",
              "technology",
              "description"
            ],
            "properties": {
              "container_id": {
                "type": "string",
                "pattern": "^CTR-"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "technology": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/c4Evidence"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "components_critical": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CMP-"
          }
        }
      },
      "additionalProperties": false
    },
    "deployment_topology": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "node_name",
          "node_type",
          "evidence"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "node_name": {
            "type": "string"
          },
          "node_type": {
            "type": "string",
            "enum": [
              "app_server",
              "web",
              "db",
              "queue",
              "batch",
              "external",
              "unknown"
            ]
          },
          "hosts_or_modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "security_controls": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "control_type",
          "description",
          "evidence"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "control_type": {
            "type": "string",
            "enum": [
              "authentication",
              "authorization",
              "secrets",
              "transport",
              "audit",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "cross_cutting_concerns": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "concern",
          "implementation",
          "evidence"
        ],
        "properties": {
          "concern": {
            "type": "string",
            "enum": [
              "caching",
              "logging",
              "serialization",
              "i18n",
              "config",
              "other"
            ]
          },
          "implementation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "build_and_runtime": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "area",
          "technology",
          "notes",
          "evidence"
        ],
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "build",
              "runtime",
              "framework",
              "serialization",
              "logging",
              "other"
            ]
          },
          "technology": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "validation_results": {
      "type": "object"
    },
    "recommendations": {
      "type": "array"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "c4Evidence": {
      "type": "object",
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "code",
            "config",
            "ddl",
            "descriptor",
            "doc",
            "log",
            "inferred"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
