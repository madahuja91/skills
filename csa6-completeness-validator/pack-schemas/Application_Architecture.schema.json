{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/Application_Architecture.schema.json",
  "title": "CSA_Application_Architecture",
  "type": "object",
  "required": [
    "architecture_layers",
    "key_components",
    "build_and_runtime",
    "deployment_topology",
    "security_controls",
    "cross_cutting_concerns",
    "runtime_evidence",
    "tech_debt_register",
    "ops_gaps"
  ],
  "properties": {
    "architecture_layers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["layer_name", "description", "key_technologies", "evidence"],
        "properties": {
          "layer_name": {
            "type": "string",
            "enum": ["presentation", "business", "data", "integration", "infrastructure"]
          },
          "description": { "type": "string", "minLength": 20 },
          "key_technologies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "key_components": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["component_id", "component_name", "layer", "responsibility", "evidence"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^CMP-" },
          "component_name": { "type": "string", "minLength": 2 },
          "layer": { "type": "string", "minLength": 2 },
          "responsibility": { "type": "string", "minLength": 15 },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "direction"],
              "properties": {
                "name": { "type": "string" },
                "direction": { "type": "string", "enum": ["in", "out", "both"] },
                "protocol": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "build_and_runtime": {
      "type": "array",
      "minItems": 3,
      "description": "Build/runtime/framework facts from technology stack analysis — not full integration catalog.",
      "items": {
        "type": "object",
        "required": ["area", "technology", "notes", "evidence"],
        "properties": {
          "area": {
            "type": "string",
            "enum": ["build", "runtime", "framework", "serialization", "logging", "other"]
          },
          "technology": { "type": "string", "minLength": 2 },
          "notes": { "type": "string", "minLength": 10 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "deployment_topology": {
      "type": "array",
      "minItems": 2,
      "description": "Current-state deployment/infrastructure nodes — diagrams live in arc42-c4 HTML.",
      "items": {
        "type": "object",
        "required": ["node_id", "node_name", "node_type", "evidence"],
        "properties": {
          "node_id": { "type": "string", "minLength": 2 },
          "node_name": { "type": "string", "minLength": 2 },
          "node_type": {
            "type": "string",
            "enum": ["app_server", "web", "db", "queue", "batch", "external", "unknown"]
          },
          "hosts_or_modules": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "security_controls": {
      "type": "array",
      "minItems": 3,
      "description": "Authn/authz/secrets/security architecture signals — not the full risk register.",
      "items": {
        "type": "object",
        "required": ["control_id", "control_type", "description", "evidence"],
        "properties": {
          "control_id": { "type": "string", "minLength": 2 },
          "control_type": {
            "type": "string",
            "enum": ["authentication", "authorization", "secrets", "transport", "audit", "other"]
          },
          "description": { "type": "string", "minLength": 15 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "cross_cutting_concerns": {
      "type": "array",
      "minItems": 3,
      "description": "Runtime cache/logging/serialization/i18n policies — entity/DB cache contents owned by Data_and_Integration.",
      "items": {
        "type": "object",
        "required": ["concern", "implementation", "evidence"],
        "properties": {
          "concern": {
            "type": "string",
            "enum": ["caching", "logging", "serialization", "i18n", "config", "other"]
          },
          "implementation": { "type": "string", "minLength": 10 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "runtime_evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["artifact", "observed_behavior", "confidence", "evidence"],
        "properties": {
          "artifact": { "type": "string" },
          "observed_behavior": { "type": "string", "minLength": 15 },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "tech_debt_register": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["debt_id", "title", "category", "severity", "impact", "evidence"],
        "properties": {
          "debt_id": { "type": "string", "pattern": "^DEBT-" },
          "title": { "type": "string", "minLength": 5 },
          "category": {
            "type": "string",
            "enum": ["Architecture", "Code", "Data", "Integration", "Ops", "Security", "Testing"]
          },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "impact": { "type": "string", "minLength": 15 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "ops_gaps": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 15 }
    }
  },
  "additionalProperties": false
}
