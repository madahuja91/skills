{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/arc42-c4-html-pack.json",
  "title": "Arc42C4HtmlPack",
  "description": "Manifest for arc42/C4 HTML index site deliverable with rich index hub",
  "type": "object",
  "required": ["format", "entry", "pages", "system_name", "index_hub"],
  "properties": {
    "format": { "const": "html" },
    "entry": {
      "type": "string",
      "pattern": ".*(csa_pack|tsa_pack)/arc42-c4/index\\.html$"
    },
    "pages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "path", "title"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["index", "context", "containers", "components"]
          },
          "path": { "type": "string", "pattern": ".*\\.html$" },
          "title": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "system_name": { "type": "string", "minLength": 1 },
    "index_hub": {
      "type": "object",
      "required": [
        "required_anchors",
        "min_word_count",
        "min_tables",
        "min_mermaid_blocks",
        "exclude_tsa_migration_framing_for_csa"
      ],
      "properties": {
        "required_anchors": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "string",
            "enum": [
              "overview",
              "inventory",
              "stack",
              "architecture",
              "domains",
              "data",
              "integrations",
              "c4",
              "runtime",
              "risks",
              "traceability",
              "pack"
            ]
          }
        },
        "min_word_count": { "type": "integer", "const": 5000 },
        "min_tables": { "type": "integer", "const": 8 },
        "min_mermaid_blocks": { "type": "integer", "const": 2 },
        "exclude_tsa_migration_framing_for_csa": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "architecture.c4_views",
          "discovery",
          "integration",
          "domain",
          "lineage"
        ]
      }
    },
    "relative_links_only": { "type": "boolean", "const": true },
    "markdown_c4_forbidden": { "type": "boolean", "const": true },
    "mermaid_required": { "type": "boolean", "const": true },
    "mermaid_diagram_ids": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "diag-c4-context",
          "diag-c4-containers",
          "diag-c4-components"
        ]
      }
    }
  },
  "additionalProperties": false
}
