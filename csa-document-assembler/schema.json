{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa-document-assembler-manifest.json",
  "title": "CSADocumentPackManifest",
  "type": "object",
  "required": [
    "pack_version",
    "sections",
    "arc42_c4_html",
    "machine_artifacts",
    "section_machine_json",
    "traceability_graph_path",
    "schema_bundle_path"
  ],
  "properties": {
    "pack_version": { "type": "string", "const": "3.0.0" },
    "generated_at": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "path", "format"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "Executive_Summary",
              "Business_Architecture",
              "Application_Architecture",
              "Data_and_Integration",
              "Risks_Gaps_and_Traceability"
            ]
          },
          "path": { "type": "string", "pattern": "^csa_pack/[A-Za-z_]+\\.md$" },
          "title": { "type": "string" },
          "format": { "type": "string", "const": "markdown" }
        },
        "additionalProperties": false
      }
    },
    "arc42_c4_html": {
      "type": "object",
      "required": ["index", "pages", "format"],
      "properties": {
        "index": { "type": "string", "pattern": ".*index\\.html$" },
        "pages": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "pattern": ".*\\.html$" }
        },
        "format": { "type": "string", "const": "html" }
      },
      "additionalProperties": false
    },
    "machine_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "section_machine_json": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "path", "schema"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "pattern": "^csa_pack/machine/sections/.*\\.json$" },
          "schema": { "type": "string", "pattern": ".*\\.schema\\.json$" },
          "markdown_path": { "type": "string", "pattern": "^csa_pack/.*\\.md$" }
        },
        "additionalProperties": false
      }
    },
    "traceability_graph_path": { "type": "string" },
    "schema_bundle_path": {
      "type": "string",
      "const": "skills/agents/csa-document-assembler/output-schemas/csa-pack-schema-bundle.json"
    },
    "mermaid_diagrams_path": {
      "type": "string",
      "const": "csa_pack/machine/mermaid_diagrams.json"
    }
  },
  "additionalProperties": false
}
