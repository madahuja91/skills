{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/11_risks_and_tech_debt.schema.json",
  "title": "Arc42_RisksAndTechDebt_Schema",
  "type": "object",
  "required": ["risk_register", "technical_debt_items"],
  "properties": {
    "risk_register": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["risk_id", "title", "severity", "impact_area", "mitigation"],
        "properties": {
          "risk_id": { "type": "string", "pattern": "^RISK-" },
          "title": { "type": "string", "minLength": 5 },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "impact_area": { "type": "string", "minLength": 3 },
          "mitigation": { "type": "string", "minLength": 15 }
        },
        "additionalProperties": false
      }
    },
    "technical_debt_items": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["debt_id", "title", "category", "severity", "impact"],
        "properties": {
          "debt_id": { "type": "string", "pattern": "^DEBT-" },
          "title": { "type": "string", "minLength": 5 },
          "category": {
            "type": "string",
            "enum": ["Architecture", "Code", "Data", "Integration", "Ops", "Security", "Testing"]
          },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "impact": { "type": "string", "minLength": 15 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
