{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/10_quality_scenarios.schema.json",
  "title": "Arc42_QualityScenarios_Schema",
  "type": "object",
  "required": ["quality_tree", "scenarios"],
  "properties": {
    "quality_tree": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["quality_attribute", "priority"],
        "properties": {
          "quality_attribute": { "type": "string", "minLength": 3 },
          "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["scenario_id", "quality_attribute", "stimulus", "response", "response_measure"],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^QS-" },
          "quality_attribute": { "type": "string", "minLength": 3 },
          "stimulus": { "type": "string", "minLength": 10 },
          "response": { "type": "string", "minLength": 10 },
          "response_measure": { "type": "string", "minLength": 5 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
