{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/Application_Architecture.schema.json",
  "title": "CSA_Application_Architecture",
  "type": "object",
  "required": [
    "architecture_layers",
    "key_components",
    "runtime_evidence",
    "tech_debt_register",
    "ops_gaps"
  ],
  "properties": {
    "architecture_layers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["layer_name", "description", "key_technologies", "evidence"],
        "properties": {
          "layer_name": {
            "type": "string",
            "enum": ["presentation", "business", "data", "integration", "infrastructure"]
          },
          "description": { "type": "string", "minLength": 20 },
          "key_technologies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "key_components": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["component_id", "component_name", "layer", "responsibility", "evidence"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^CMP-" },
          "component_name": { "type": "string", "minLength": 2 },
          "layer": { "type": "string", "minLength": 2 },
          "responsibility": { "type": "string", "minLength": 15 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "runtime_evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["artifact", "observed_behavior", "confidence", "evidence"],
        "properties": {
          "artifact": { "type": "string" },
          "observed_behavior": { "type": "string", "minLength": 15 },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "tech_debt_register": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["debt_id", "title", "category", "severity", "impact", "evidence"],
        "properties": {
          "debt_id": { "type": "string", "pattern": "^DEBT-" },
          "title": { "type": "string", "minLength": 5 },
          "category": {
            "type": "string",
            "enum": ["Architecture", "Code", "Data", "Integration", "Ops", "Security", "Testing"]
          },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "impact": { "type": "string", "minLength": 15 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "ops_gaps": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 15 }
    }
  },
  "additionalProperties": false
}
