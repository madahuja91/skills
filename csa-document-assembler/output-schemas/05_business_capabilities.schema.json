{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/05_business_capabilities.schema.json",
  "title": "CSA_BusinessCapabilities_Schema",
  "type": "object",
  "required": ["capability_taxonomy", "gap_analysis_bullets"],
  "properties": {
    "capability_taxonomy": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "l1_capability",
          "l2_capability",
          "criticality",
          "realizing_components",
          "evidence"
        ],
        "properties": {
          "capability_id": { "type": "string", "pattern": "^CAP-" },
          "l1_capability": { "type": "string", "minLength": 2 },
          "l2_capability": { "type": "string", "minLength": 2 },
          "criticality": {
            "type": "string",
            "enum": ["Mission-Critical", "Business-Operational", "Administrative"]
          },
          "realizing_components": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "gap_analysis_bullets": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 20 }
    }
  },
  "additionalProperties": false
}
