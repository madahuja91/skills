{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/06_runtime_view.schema.json",
  "title": "Arc42_RuntimeView_Schema",
  "type": "object",
  "required": ["key_scenarios"],
  "properties": {
    "key_scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["scenario_id", "scenario_name", "sequence_steps", "evidence"],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^RT-" },
          "scenario_name": { "type": "string", "minLength": 5 },
          "trigger_event": { "type": "string", "minLength": 5 },
          "sequence_steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["step_number", "caller", "receiver", "action_or_method", "sync_or_async"],
              "properties": {
                "step_number": { "type": "integer", "minimum": 1 },
                "caller": { "type": "string", "minLength": 2 },
                "receiver": { "type": "string", "minLength": 2 },
                "action_or_method": { "type": "string", "minLength": 3 },
                "sync_or_async": { "type": "string", "enum": ["SYNC", "ASYNC"] }
              },
              "additionalProperties": false
            }
          },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
