{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/00_executive_summary.schema.json",
  "title": "CSA_ExecutiveSummary_Schema",
  "type": "object",
  "required": [
    "system_overview",
    "key_metrics_table",
    "modernization_readiness_scorecard",
    "key_architectural_findings",
    "top_technical_risks"
  ],
  "properties": {
    "system_overview": {
      "type": "object",
      "required": ["system_name", "primary_business_purpose", "architecture_pattern", "scope_summary"],
      "properties": {
        "system_name": { "type": "string", "minLength": 2 },
        "primary_business_purpose": { "type": "string", "minLength": 40 },
        "architecture_pattern": {
          "type": "string",
          "enum": ["Monolith", "Distributed Stored Procedures", "Layered N-Tier", "Microservices", "Hybrid"]
        },
        "scope_summary": { "type": "string", "minLength": 40 }
      },
      "additionalProperties": false
    },
    "key_metrics_table": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["category", "count", "tech_stack", "health_status"],
        "properties": {
          "category": { "type": "string", "minLength": 2 },
          "count": { "type": "integer", "minimum": 0 },
          "tech_stack": { "type": "string", "minLength": 2 },
          "health_status": {
            "type": "string",
            "enum": ["Healthy", "Legacy - Action Needed", "Critical Risk"]
          }
        },
        "additionalProperties": false
      }
    },
    "modernization_readiness_scorecard": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["dimension", "score", "rationale", "evidence"],
        "properties": {
          "dimension": { "type": "string" },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "rationale": { "type": "string", "minLength": 20 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "key_architectural_findings": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 30 }
    },
    "top_technical_risks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["risk_id", "risk_title", "impact_area", "severity", "brief_mitigation", "evidence"],
        "properties": {
          "risk_id": { "type": "string", "pattern": "^RISK-" },
          "risk_title": { "type": "string", "minLength": 5 },
          "impact_area": { "type": "string", "minLength": 3 },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "brief_mitigation": { "type": "string", "minLength": 20 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
