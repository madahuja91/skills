{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/01_goals_and_constraints.schema.json",
  "title": "Arc42_GoalsAndConstraints_Schema",
  "type": "object",
  "required": ["quality_goals", "stakeholders", "constraints"],
  "properties": {
    "quality_goals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["goal_id", "goal", "priority", "evidence"],
        "properties": {
          "goal_id": { "type": "string", "pattern": "^QG-" },
          "goal": { "type": "string", "minLength": 15 },
          "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["stakeholder", "role", "expectations"],
        "properties": {
          "stakeholder": { "type": "string", "minLength": 2 },
          "role": { "type": "string", "minLength": 2 },
          "expectations": { "type": "string", "minLength": 15 }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["constraint_id", "category", "description", "evidence"],
        "properties": {
          "constraint_id": { "type": "string", "pattern": "^CON-" },
          "category": { "type": "string", "enum": ["Technical", "Organizational", "Regulatory", "Operational"] },
          "description": { "type": "string", "minLength": 15 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
