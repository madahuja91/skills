{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/07_deployment_view.schema.json",
  "title": "Arc42_DeploymentView_Schema",
  "type": "object",
  "required": ["environments"],
  "properties": {
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["environment_name", "infrastructure_nodes", "evidence"],
        "properties": {
          "environment_name": { "type": "string", "enum": ["DEV", "STAGING", "PROD", "UNKNOWN"] },
          "infrastructure_nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["node_id", "node_type", "deployed_artifacts"],
              "properties": {
                "node_id": { "type": "string", "minLength": 2 },
                "node_type": { "type": "string", "minLength": 2 },
                "deployed_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "scaling_policy": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
