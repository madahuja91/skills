{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/05_building_block_view.schema.json",
  "title": "Arc42_BuildingBlockView_Schema",
  "type": "object",
  "required": ["level_1_components"],
  "properties": {
    "level_1_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "component_name", "primary_responsibility", "source_packages"],
        "properties": {
          "component_id": { "type": "string" },
          "component_name": { "type": "string" },
          "primary_responsibility": { "type": "string" },
          "source_packages": { "type": "array", "items": { "type": "string" } },
          "level_2_subcomponents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["subcomponent_name", "subcomponent_role"],
              "properties": {
                "subcomponent_name": { "type": "string" },
                "subcomponent_role": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
