{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csa.local/schemas/csa-pack-schema-bundle.json",
  "title": "CsaPackSchemaBundle",
  "type": "object",
  "required": ["version", "schemas", "markdown_section_machine_json"],
  "properties": {
    "version": { "type": "string", "const": "2.1.0" },
    "markdown_section_machine_json": {
      "type": "object",
      "description": "Primary MD sections must be rendered from these machine JSON files after schema validation",
      "required": [
        "00_executive_summary",
        "04_domain_model_ddd",
        "05_business_capabilities",
        "06_data_architecture_lineage",
        "07_integration_landscape",
        "08_runtime_ops_tech_debt",
        "09_traceability_matrix",
        "10_gaps_risks_assumptions"
      ],
      "properties": {
        "00_executive_summary": { "const": "csa_pack/machine/sections/00_executive_summary.json" },
        "04_domain_model_ddd": { "const": "csa_pack/machine/sections/04_domain_model_ddd.json" },
        "05_business_capabilities": { "const": "csa_pack/machine/sections/05_business_capabilities.json" },
        "06_data_architecture_lineage": { "const": "csa_pack/machine/sections/06_data_architecture_lineage.json" },
        "07_integration_landscape": { "const": "csa_pack/machine/sections/07_integration_landscape.json" },
        "08_runtime_ops_tech_debt": { "const": "csa_pack/machine/sections/08_runtime_ops_tech_debt.json" },
        "09_traceability_matrix": { "const": "csa_pack/machine/sections/09_traceability_matrix.json" },
        "10_gaps_risks_assumptions": { "const": "csa_pack/machine/sections/10_gaps_risks_assumptions.json" }
      },
      "additionalProperties": false
    },
    "schemas": {
      "type": "object",
      "required": [
        "00_executive_summary",
        "01_goals_and_constraints",
        "03_context_and_scope",
        "04_domain_model_ddd",
        "05_business_capabilities",
        "05_building_block_view",
        "06_data_architecture_lineage",
        "06_runtime_view",
        "07_integration_landscape",
        "07_deployment_view",
        "08_runtime_ops_tech_debt",
        "08_cross_cutting_concepts",
        "09_architectural_decisions",
        "09_traceability_matrix",
        "10_quality_scenarios",
        "10_gaps_risks_assumptions",
        "11_risks_and_tech_debt",
        "12_glossary"
      ],
      "properties": {
        "00_executive_summary": { "const": "00_executive_summary.schema.json" },
        "01_goals_and_constraints": { "const": "01_goals_and_constraints.schema.json" },
        "03_context_and_scope": { "const": "03_context_and_scope.schema.json" },
        "04_domain_model_ddd": { "const": "04_domain_model_ddd.schema.json" },
        "05_business_capabilities": { "const": "05_business_capabilities.schema.json" },
        "05_building_block_view": { "const": "05_building_block_view.schema.json" },
        "06_data_architecture_lineage": { "const": "06_data_architecture_lineage.schema.json" },
        "06_runtime_view": { "const": "06_runtime_view.schema.json" },
        "07_integration_landscape": { "const": "07_integration_landscape.schema.json" },
        "07_deployment_view": { "const": "07_deployment_view.schema.json" },
        "08_runtime_ops_tech_debt": { "const": "08_runtime_ops_tech_debt.schema.json" },
        "08_cross_cutting_concepts": { "const": "08_cross_cutting_concepts.schema.json" },
        "09_architectural_decisions": { "const": "09_architectural_decisions.schema.json" },
        "09_traceability_matrix": { "const": "09_traceability_matrix.schema.json" },
        "10_quality_scenarios": { "const": "10_quality_scenarios.schema.json" },
        "10_gaps_risks_assumptions": { "const": "10_gaps_risks_assumptions.schema.json" },
        "11_risks_and_tech_debt": { "const": "11_risks_and_tech_debt.schema.json" },
        "12_glossary": { "const": "12_glossary.schema.json" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
