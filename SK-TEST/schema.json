{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-story.local/schemas/sk-test.json",
  "title": "TestScenarios",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "active_root",
    "artifact_paths",
    "mode",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skill_id": {
      "const": "SK-TEST"
    },
    "active_root": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative ACTIVE_ROOT (prefer src). Never src/src."
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Expected under ACTIVE_ROOT: artifacts/cs/test_scenarios.json, artifacts/ts/test_scenarios.json"
    },
    "mode": {
      "type": "string",
      "enum": [
        "cs",
        "ts"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "story_id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "story_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "md_updated": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
